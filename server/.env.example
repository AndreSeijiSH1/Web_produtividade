# Copie este arquivo para ".env" e preencha.

# Endereço do banco PostgreSQL (o Neon mostra esse texto em "Connection string")
DATABASE_URL=postgresql://usuario:senha@localhost:5432/organizador

# Um texto longo e aleatório. Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-texto-bem-longo-e-aleatorio

# Endereço do front. No deploy, o link do Netlify (ex.: https://meu-organizador.netlify.app)
FRONT_URL=http://localhost:5173

# Fuso horário usado para contar o tempo de estudo por dia
APP_TZ=America/Sao_Paulo

PORT=3001
